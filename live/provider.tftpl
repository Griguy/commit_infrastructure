# This file is processed with templatefile() function in 

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = "${region}"

  default_tags {
    tags = {
      Project = var.project_name
      Environment = var.environment
    }
  }
}
